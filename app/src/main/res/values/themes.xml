<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.JobInvoicingAssist" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.JobInvoicingAssist" parent="Base.Theme.JobInvoicingAssist" />
    <style name="HintStyle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColorHint">#999999</item>
    </style>

    <style name="BottomNavTextStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="FilterPopupMenuStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/filter_popup_bg</item>
    </style>
    <style name="CustomExposedDropdownStyle"
        parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

        <item name="boxBackgroundColor">@color/white_color_state_list</item>
        <!-- Focused (pressed/clicked) → DARK GREY -->  <item name="boxStrokeColor">@color/text_input_stroke</item>

        <!-- Hint text -->
        <item name="hintTextColor">@color/black</item>

        <!-- Dropdown arrow icon -->
        <item name="endIconTint">@color/grey_600</item>

    </style>
    <style name="Theme.MyApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorControlActivated">@color/grey_700</item>
    </style>
    <style name="CustomOutlinedBoxStyle"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <!-- Stroke color with states -->
        <item name="boxStrokeColor">@color/text_input_outline_stroke</item>

        <!-- Hint -->
        <item name="hintTextColor">@color/grey_500</item>

    </style>
    <style name="InvoiceHintText"
        parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">20sp</item>
    </style>


</resources>