<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/workplan_details"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".WorkPlanDetailsActivity">
    <!-- Top bar -->
    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

    <!-- Middle section -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingStart="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Client Name"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/customerNameEditText"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/edittext_bg"
                android:layout_marginTop="8dp"
                android:paddingStart="14dp"
                android:inputType="textPersonName"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Work Title"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/workTitleEditText"
                android:layout_width="match_parent"
                android:paddingStart="14dp"
                android:layout_height="60dp"
                android:background="@drawable/edittext_bg"
                android:layout_marginTop="8dp"
                android:inputType="textPersonName"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Work Description"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/workDescriptionEditText"
                android:layout_width="match_parent"
                android:paddingStart="14dp"
                android:layout_height="60dp"
                android:background="@drawable/edittext_bg"
                android:layout_marginTop="8dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Work Location"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/addressEditText"
                android:layout_width="match_parent"
                android:paddingStart="14dp"
                android:layout_height="60dp"
                android:background="@drawable/edittext_bg"
                android:layout_marginTop="8dp"
                android:inputType="textPostalAddress"
                android:textSize="20sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Date"
                android:textSize="24sp"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/dateEditText"
                android:layout_width="match_parent"
                android:paddingStart="14dp"
                android:layout_height="60dp"
                android:background="@drawable/edittext_bg"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="false"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Status"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <RadioGroup
                android:id="@+id/statusRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/statusOpen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/radio_button_left_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:text="Open"
                    android:textColor="@color/radio_button_text_color_selector" />

                <RadioButton
                    android:id="@+id/statusInProgress"
                    android:layout_width="0dp"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/radio_button_middle_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="In Progress"
                    android:textColor="@color/radio_button_text_color_selector" />

                <RadioButton
                    android:id="@+id/statusClosed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:background="@drawable/radio_button_right_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Closed"
                    android:textColor="@color/radio_button_text_color_selector" />
            </RadioGroup>

            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/button_rectangle"
                android:text="@string/save_changes"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/timeEntriesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_time_entry" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/materialsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_material" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/serviceItemsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_service_item" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/distancesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_distance" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/weightsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_weight" />


            <!-- Time Entry Section -->
            <RelativeLayout
                android:id="@+id/timeEntryHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Time Entry"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/timeEntryToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_baseline_keyboard_arrow_down_24" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/timeEntryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <EditText
                    android:id="@+id/timeEntryHoursEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Hours"
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/timeEntryHourRateEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Hour Rate"
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/timeEntryNotesEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="Notes"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/importFromTimerButton"
                        android:background="@drawable/rounded_black_button"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        app:backgroundTint="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Import from Timer"/>

                    <Button
                        android:id="@+id/addTimeEntryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:background="@drawable/rounded_white_border"
                        android:textColor="#000"
                        android:textSize="18sp"
                        app:backgroundTint="@null"
                        android:text="Add Time Entry" />
                </LinearLayout>


            </LinearLayout>

            <!-- Material Section -->
            <RelativeLayout
                android:id="@+id/materialHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Material"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/materialToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_baseline_keyboard_arrow_down_24" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/materialContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <EditText
                    android:id="@+id/materialNameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Material Name"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/materialQuantityEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Quantity"
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/materialUnitEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Unit (e.g., pcs, m, kg)"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/materialUnitPriceEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Unit Price"
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/materialNotesEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="Notes"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <Button
                    android:id="@+id/addMaterialButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="@drawable/rounded_black_button"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    app:backgroundTint="@null"
                    android:text="Add Material" />

            </LinearLayout>

            <!-- Service Section -->
            <RelativeLayout
                android:id="@+id/serviceItemHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Service"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/serviceItemToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_baseline_keyboard_arrow_down_24" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/serviceItemContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <EditText
                    android:id="@+id/serviceItemDescriptionEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Description"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/serviceItemFeeEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Service Fee"
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/serviceItemNotesEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="Notes"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <Button
                    android:id="@+id/addServiceItemButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="@drawable/rounded_black_button"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    app:backgroundTint="@null"
                    android:text="Add Service" />

            </LinearLayout>

            <!-- Distance Section -->
            <RelativeLayout
                android:id="@+id/distanceHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Distance"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/distanceToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_baseline_keyboard_arrow_down_24"
                    />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/distanceContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <EditText
                    android:id="@+id/distanceEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Distance"
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/distanceUnitEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Distance unit (m, km, mile)"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/distanceRateEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Rate per unit"
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/distanceNotesEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Notes"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:gravity="top"/>

                <Button
                    android:id="@+id/addDistanceButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Distance"
                    android:background="@drawable/rounded_black_button"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    app:backgroundTint="@null"
                    android:layout_gravity="end"/>

            </LinearLayout>

            <!-- Weight Section -->
            <RelativeLayout
                android:id="@+id/weightHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Weight"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/weightToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_baseline_keyboard_arrow_down_24"
                    />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/weightContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <EditText
                    android:id="@+id/weightEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Weight"
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/weightUnitEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Weight unit (kg, lbs, ton)"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/weightRateEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Rate per unit"
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/weightNotesEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Notes"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:gravity="top"/>

                <Button
                    android:id="@+id/addWeightButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Weight"
                    android:background="@drawable/rounded_black_button"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    app:backgroundTint="@null"
                    android:layout_gravity="end"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
