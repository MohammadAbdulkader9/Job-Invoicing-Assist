<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="32dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- TITLE -->
        <TextView
            android:id="@+id/tvTitle"
            android:text="Operator Profile"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:text="Manage your personal information"
            android:textSize="18sp"
            android:textColor="#777"
            android:paddingBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- FORM CARD -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/formCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="32dp"
            android:background="@drawable/card_background">

            <!-- Full Name -->
            <TextView
                android:id="@+id/lblFullName"
                android:text="Full Name *"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/etFullName"
                android:hint="Enter your full name"

                android:textSize="20sp"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:paddingLeft="12dp"
                android:background="@drawable/edittext_bg"
                app:layout_constraintTop_toBottomOf="@id/lblFullName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Role -->
            <TextView
                android:id="@+id/lblRole"
                android:text="Role *"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:layout_constraintTop_toBottomOf="@id/etFullName"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/etRole"
                android:hint="Operator"
                android:enabled="false"

                android:textSize="20sp"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:paddingLeft="12dp"
                android:background="@drawable/edittext_bg"
                app:layout_constraintTop_toBottomOf="@id/lblRole"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Divider -->
            <View
                android:id="@+id/divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="#DDD"
                app:layout_constraintTop_toBottomOf="@id/etRole"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Email -->
            <TextView
                android:id="@+id/lblEmail"
                android:text="Email Address *"
                android:textStyle="bold"
                android:textSize="24sp"
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/divider"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/etEmail"
                android:hint="Enter your email address"

                android:textSize="20sp"
                android:inputType="textEmailAddress"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:paddingLeft="12dp"
                android:background="@drawable/edittext_bg"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/lblEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Phone -->
            <TextView
                android:id="@+id/lblPhone"
                android:text="Phone Number *"
                android:textStyle="bold"
                android:textSize="24sp"
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/etEmail"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/etPhone"

                android:textSize="20sp"
                android:inputType="phone"
                android:maxLength="13"
                android:hint="+46 7XXXXXXXX"
                android:text="+46"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:paddingLeft="12dp"
                android:background="@drawable/edittext_bg"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/lblPhone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- BUTTON ROW -->
            <LinearLayout
                android:id="@+id/layoutButtons"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                app:layout_constraintTop_toBottomOf="@id/etPhone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- CANCEL -->
                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/rounded_white_border"
                    android:text="@string/cancel"
                    android:textColor="#000"
                    android:textSize="26sp"
                    app:backgroundTint="@null"
                    android:layout_weight="1" />

                <!-- SAVE -->
                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:text="Create Profile"
                    android:background="@drawable/rounded_black_button"
                    android:textColor="@android:color/white"
                    android:textSize="26sp"
                    app:backgroundTint="@null"
                    android:layout_weight="1" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- OPERATORS LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOperators"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp" />

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNavigationView"
        layout="@layout/view_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>