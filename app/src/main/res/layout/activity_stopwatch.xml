<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Current entry name (new) -->
    <TextView
        android:id="@+id/entry_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No entry selected"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="12dp" />

    <!-- Timer display -->
    <TextView
        android:id="@+id/stopwatch_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00:00"
        android:textSize="54sp"
        android:textStyle="bold"
        android:layout_below="@id/entry_name"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp" />

    <!-- Add / Switch buttons (new) -->
    <LinearLayout
        android:id="@+id/top_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/stopwatch_timer"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:padding="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopwatch_add"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add"
            app:icon="@drawable/ic_baseline_add_24"
            app:iconTint="@color/black"
            android:layout_marginEnd="8dp"
            app:strokeWidth="2dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopwatch_switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Switch"
            app:icon="@drawable/ic_baseline_list_24"
            app:iconTint="@color/black"
            android:layout_marginStart="8dp"
            app:strokeWidth="2dp"/>
    </LinearLayout>

    <!-- Control buttons row (Start / Pause / Reset) -->
    <LinearLayout
        android:id="@+id/button_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_buttons"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:padding="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopwatch_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Start"
            app:icon="@drawable/baseline_play_arrow_24"
            app:iconTint="@color/black"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopwatch_pause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="Pause"
            app:icon="@drawable/outline_autopause_24"
            app:iconTint="@color/black"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopwatch_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Reset"
            app:icon="@drawable/outline_autorenew_24"
            app:strokeWidth="2dp" />
    </LinearLayout>

</RelativeLayout>
