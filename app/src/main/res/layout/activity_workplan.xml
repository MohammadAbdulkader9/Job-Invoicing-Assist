<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/workplan"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".WorkPlanActivity">

    <!-- Top bar -->
    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

    <!-- ============================= -->
    <!--        FORM SECTION           -->
    <!-- ============================= -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- FORM CARD -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/formCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:padding="32dp">

                <!-- Client Name -->
                <TextView
                    android:id="@+id/lblFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/client"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <AutoCompleteTextView
                    android:id="@+id/inputClientName"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="6dp"
                    android:paddingLeft="12dp"
                    tools:ignore="Autofill"
                    android:completionThreshold="1"
                    android:inputType="textPersonName"
                    android:background="@drawable/edittext_bg"
                    android:drawableEnd="@android:drawable/arrow_down_float"
                    app:layout_constraintTop_toBottomOf="@id/lblFullName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"  />


                <!-- Workplan Title -->
                <TextView
                    android:id="@+id/lblRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Work Title"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/inputClientName" />

                <EditText
                    android:id="@+id/inputWorkPlanTitle"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="@string/enter_job_title"
                    android:inputType="textCapWords"
                    android:paddingStart="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblRole" />

                <!-- Divider -->
                <View
                    android:id="@+id/divider"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="#DDD"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/inputWorkPlanTitle" />

                <!-- Job Description -->
                <TextView
                    android:id="@+id/lblEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Work Description"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider" />

                <EditText
                    android:id="@+id/inputJobDescription"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/edittext_bg"
                    android:gravity="top"
                    android:hint="@string/enter_job_des"
                    android:inputType="textMultiLine"
                    android:maxLines="12"
                    android:minLines="4"
                    android:paddingLeft="12dp"
                    android:scrollHorizontally="false"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblEmail"
                    tools:ignore="Autofill" />

                <!-- Work Location -->
                <TextView
                    android:id="@+id/lblPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Work Location"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/inputJobDescription" />

                <EditText
                    android:id="@+id/inputJobLocation"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/edittext_bg"
                    android:drawableStart="@drawable/ic_baseline_add_location_24"
                    android:hint="@string/enter_location"
                    android:inputType="textCapWords"
                    android:paddingLeft="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblPhone"
                    tools:ignore="Autofill" />

                <!-- BUTTON ROW -->
                <LinearLayout
                    android:id="@+id/layoutButtons"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/inputJobLocation">

                    <!-- CANCEL -->
                    <Button
                        android:id="@+id/btnCancel"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_white_border"
                        android:text="@string/cancel"
                        android:textColor="#000"
                        android:textSize="26sp"
                        app:backgroundTint="@null" />

                    <Space
                        android:layout_width="24dp"
                        android:layout_height="match_parent" />
                    <!-- create -->
                    <Button
                        android:id="@+id/btnCreate"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_black_button"
                        android:text="@string/create"
                        android:textColor="@android:color/white"
                        android:textSize="26sp"
                        app:backgroundTint="@null" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>



